rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // HELPER FUNCTIONS FOR AUTH & ROLE VALIDATION
    // ==========================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // STRICT PERMANENT OWNER VALIDATION (Immutable & Protected)
    function isOwner() {
      return isAuthenticated() && (
        request.auth.uid == 'nJqbz63bzIXRiycPC5JYA13pVOi1' ||
        (request.auth.token.email != null && (
          request.auth.token.email == 'mahincollege1@gmail.com' ||
          request.auth.token.email == 'admin@houseofmahi.com' ||
          request.auth.token.email == 'houseofmahibd@gmail.com'
        ))
      );
    }

    // ACTIVE STAFF VALIDATION (Owner, Full Access, Editor, Viewer)
    function isStaffActive() {
      return isAuthenticated() && (
        isOwner() ||
        (exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.status == 'active')
      );
    }

    // OPERATIONAL STAFF VALIDATION (Owner, Full Access, Editor - Can modify store data)
    function isStaffEditorOrFull() {
      return isStaffActive() && (
        isOwner() ||
        (exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role == 'editor' ||
          get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role == 'full_access'))
      );
    }

    // Backwards compatibility alias for existing admin checks
    function isAuthorizedAdmin() {
      return isStaffActive();
    }

    // SAFE CUSTOMER CHECKOUT VALIDATION (Guards against schema tampering & fake delivered orders)
    function isValidOrderCreate() {
      return request.resource.data.keys().hasAll(['items', 'customer', 'total', 'status']) &&
             request.resource.data.items is list &&
             request.resource.data.items.size() > 0 &&
             request.resource.data.customer is map &&
             request.resource.data.customer.keys().hasAll(['name', 'phone', 'address']) &&
             request.resource.data.customer.phone is string &&
             request.resource.data.customer.phone.size() >= 10 &&
             request.resource.data.total is number &&
             request.resource.data.total >= 0 &&
             request.resource.data.status in ['Pending', 'pending', 'Processing', 'processing'];
    }

    // ==========================================
    // 0. STAFF & PERMISSIONS REGISTRY
    // ==========================================
    match /admin_users/{staffId} {
      // Staff members can read their own profile, Owner can read all
      allow read: if isAuthenticated() && (
        isOwner() ||
        request.auth.uid == staffId ||
        (resource != null && resource.data.email == request.auth.token.email)
      );

      // Only Permanent Owner can authorize new staff
      allow create: if isOwner() && (
        request.resource.data.role in ['viewer', 'editor', 'full_access'] &&
        request.resource.data.isOwner == false
      );

      // Updates strictly protect Permanent Owner from demotion or suspension
      allow update: if isOwner() && (
        // Case 1: Owner updating own profile - cannot change role from owner or suspend
        (staffId == 'nJqbz63bzIXRiycPC5JYA13pVOi1' &&
         request.resource.data.role == 'owner' &&
         request.resource.data.status == 'active' &&
         request.resource.data.isOwner == true) ||
        // Case 2: Owner managing staff - cannot assign owner role to any other account
        (staffId != 'nJqbz63bzIXRiycPC5JYA13pVOi1' &&
         request.resource.data.role in ['viewer', 'editor', 'full_access'] &&
         request.resource.data.isOwner == false)
      );

      // Deletions: Permanent Owner record can NEVER be deleted
      allow delete: if isOwner() && staffId != 'nJqbz63bzIXRiycPC5JYA13pVOi1';
    }

    // ==========================================
    // 1. PRODUCTS COLLECTION
    // ==========================================
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isStaffEditorOrFull();
    }

    // ==========================================
    // 2. CATEGORIES COLLECTION
    // ==========================================
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isStaffEditorOrFull();
    }

    // ==========================================
    // 3. HERO & PROMO BANNERS
    // ==========================================
    match /heroBanners/{bannerId} {
      allow read: if true;
      allow create, update, delete: if isStaffEditorOrFull();
    }

    match /homepageSections/{sectionId} {
      allow read: if true;
      allow create, update, delete: if isStaffEditorOrFull();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow create, update, delete: if isStaffEditorOrFull();
    }

    // ==========================================
    // 4. COUPONS COLLECTION
    // ==========================================
    match /coupons/{couponId} {
      allow read: if true;
      allow create, update, delete: if isStaffEditorOrFull();
    }

    // ==========================================
    // 5. STORE SETTINGS & MARKETING CONFIGS
    // ==========================================
    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    // ==========================================
    // 6. ORDERS COLLECTION
    // ==========================================
    match /orders/{orderId} {
      // Safe guest & customer checkout
      allow create: if isValidOrderCreate();

      // Read: Active staff or authenticated customer reading their own order
      allow read: if isStaffActive() || (
        isAuthenticated() && (
          (resource.data.keys().hasAny(['userId']) && resource.data.userId == request.auth.uid) ||
          (resource.data.keys().hasAny(['customerId']) && resource.data.customerId == request.auth.uid) ||
          (resource.data.keys().hasAny(['customer']) && resource.data.customer.keys().hasAny(['email']) && resource.data.customer.email == request.auth.token.email)
        )
      );

      // Order status updates, tracking changes, or deletion (Editor, Full Access, Owner)
      allow update, delete: if isStaffEditorOrFull();
    }

    // ==========================================
    // 7. USERS COLLECTION (Customer Accounts)
    // ==========================================
    match /users/{userId} {
      allow read: if isUser(userId) || isStaffActive();
      
      allow create: if isUser(userId) && (
        !request.resource.data.keys().hasAny(['role']) || 
        request.resource.data.role == 'customer' ||
        isStaffActive()
      );
      
      allow update: if (
        isUser(userId) && 
        (
          !request.resource.data.keys().hasAny(['role']) || 
          request.resource.data.role == resource.data.role ||
          request.resource.data.role == 'customer'
        )
      ) || isStaffEditorOrFull();
      
      allow delete: if isStaffEditorOrFull();
    }

    // ==========================================
    // 8. REVIEWS COLLECTION
    // ==========================================
    match /reviews/{reviewId} {
      allow read: if true;

      allow create: if isStaffEditorOrFull() || (
        isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        request.resource.data.keys().hasAll(['productId', 'userId', 'userName', 'rating', 'comment', 'verifiedPurchase']) &&
        (
          !request.resource.data.keys().hasAny(['orderId']) ||
          request.resource.data.orderId == '' ||
          (
            exists(/databases/$(database)/documents/orders/$(request.resource.data.orderId)) &&
            (
              get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.status in ['Delivered', 'delivered'] ||
              get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.orderStatus in ['Delivered', 'delivered']
            ) &&
            (
              get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.userId == request.auth.uid ||
              get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.customerId == request.auth.uid
            )
          )
        )
      );

      allow update: if isStaffEditorOrFull() || (
        isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.productId == resource.data.productId &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5
      );

      allow delete: if isStaffEditorOrFull();
    }

    // ==========================================
    // 9. COURIER CONFIGURATIONS (SENSITIVE KEYS)
    // ==========================================
    match /courier_configs/{courierId} {
      // Strictly restricted to Permanent Store Owner only
      allow read, write: if isOwner();
    }

    // ==========================================
    // 10. PAYMENT METHODS & GATEWAY CONFIGS
    // ==========================================
    match /payment_methods/{id} {
      allow read: if true;
      allow write: if isOwner();
    }
  }
}
